{
  "name": "lujo-lavadoras-pruebas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pruebas funcionales y de cobertura del backend de Lujo Lavadoras",
  "scripts": {
    "cobertura": "cd .. && c8 --exclude=pruebas/** --reporter=text --reporter=html --reporter=json-summary --report-dir=docs/coverage --clean=true node --env-file=backend/.env pruebas/coverage-run.mjs",
    "funcionales": "cd .. && node --env-file=backend/.env pruebas/coverage-run.mjs"
  },
  "dependencies": {
    "c8": "^10.1.3",
    "newman": "^6.2.1"
  }
}
